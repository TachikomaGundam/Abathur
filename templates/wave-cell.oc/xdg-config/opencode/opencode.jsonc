{
  "$schema": "https://opencode.ai/config.json",
  "//": "Cell-side XDG_CONFIG_HOME for opencode-target cells (net=host). Endpoint pinned to loopback sanitizer proxy; mirrors the host-verified provider block. Gap named: this dir is outside the template-file hash coverage (L-SINGLE-SOURCE follow-up on the todo list).",
  "provider": {
    "local-qwen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local vLLM",
