        "baseURL": "http://127.0.0.1:8010/v1",
        "apiKey": "dummy",
        "name": "local-qwen"
      },
      "models": {
        "qwen3.8-flash-next": {
          "name": "Qwen3.8 Flash FP8"
        }
      }
    }
  },
  "model": "local-qwen/qwen3.8-flash-next",
  "autoupdate": false,
  "share": "disabled"
}
