# build output (regenerated by `npm run build`)
dist/
node_modules/

# runtime state — never tracked (todo 2 owns .state/ layout)
.state/

# machine-local config overlays — gitignored by contract (plan: "PREFERENCE: *.local.jsonc")
*.local.jsonc

# OS/editor noise
.DS_Store
*.swp

# codegraph MCP local index (machine-local tooling).
# The workspace entry is a SYMLINK, so the `.codegraph/` directory pattern
# never matches it — pin the root path itself (matches file, symlink, or dir).
/.codegraph
.codegraph/
